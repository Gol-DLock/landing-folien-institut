# ============================================================
# Resend (Mailversand) — erforderlich für Lead-Bestätigungen
# ============================================================
RESEND_API_KEY=re_...

# Empfänger der internen Lead-Mail (Folien Institut)
MAIL_TO=hallo@turm.media

# Absender für die interne Lead-Mail
MAIL_FROM_INTERNAL=Folien Institut Leads <leads@turm.media>

# Absender für die Kunden-Bestätigung (sollte mit Brand übereinstimmen)
MAIL_FROM_BRAND=Folien Institut <noreply@turm.media>

# Reply-To für die Kunden-Bestätigung (wo Antworten landen)
MAIL_REPLY_TO_BRAND=hallo@turm.media

# Prefix für die interne Lead-Mail Betreffzeile
LEAD_SUBJECT_PREFIX=[Lead Folien Institut]

# Basis-URL für Logo in Mails (sollte Production-URL sein)
NEXT_PUBLIC_SITE_URL=https://landing-folien-institut.vercel.app
